# ===============================================================
# Environment Configuration for Social-Aware Hybrid Music Recommender
# ===============================================================
# NOTE: DO NOT COMMIT REAL API KEYS TO REPOSITORY.
#
# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True
DATABASE_URL=sqlite:///./music_recommender.db

# Music Metadata APIs
# Last.fm API Key (Optional but recommended for live chart listener counts)
# Get a free key at: https://www.last.fm/api/account/create
LASTFM_API_KEY=5baa13da3a708509d8162346305974c8

# MusicBrainz Web Service (No API key required; strictly rate-limited to 1 req/sec)
# User-Agent header must identify your application
MUSICBRAINZ_USER_AGENT=TWSMAMusicRecommender/1.0.0 (contact@example.com)

# YouTube Playback Resolution
# YouTube Data API v3 Key (Optional for live YouTube search API resolution)
# If left blank, legitimate search-embed player resolution is used
YOUTUBE_API_KEY=

# TWSMA (Text, Web & Social Media Analytics)
# Permitted RSS music news feeds (comma-separated URLs)
MUSIC_RSS_FEEDS=https://pitchfork.com/feed/feed-news/rss,https://feeds.feedburner.com/stereogum/cBYa

# Recommendation Default Weights (Must be float values)
WEIGHT_CONTENT=0.40
WEIGHT_COLLABORATIVE=0.30
WEIGHT_TREND=0.20
WEIGHT_TEXT=0.10
